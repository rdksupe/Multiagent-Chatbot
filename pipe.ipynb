    "from datetime import date\n",
    "start = time.time()\n",
    "today = date.today()\n",
    "\n",
    "for chunk in app.stream(\n",
    "    {\"messages\": [\n",
    "        (\"system\", f\"Today's date is {today}. Keep this date in mind while making queries. When asked do the assigned task as is dont ask further questions. Dont use the web scrape tool more than 2 times. If linkedin post returns null wait 15-20 seconds and try again.Dont make more than 2 web search tool uses.\"),\n",
    "        (\"human\", \"Can you post what happened to andrew tate recently ?\")\n",
    "    ]},\n",
    "    stream_mode=\"values\"\n",
    "):\n",
    "    chunk[\"messages\"][-1].pretty_print()\n",
    "end = time.time()\n",
    "print(f\"inference time {end-start}\")"
